{
  "name": "wordgrid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "check:functions": "wrangler pages functions build functions --outdir .wrangler/functions-build",
    "test": "node scripts/verify-word-list.mjs && node scripts/test-complete.cjs",
    "generate:complete": "node scripts/generate-complete.cjs"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.6",
    "typescript": "^5",
    "wrangler": "4.166.0"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
